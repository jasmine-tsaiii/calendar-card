# Claude API 金鑰（https://console.anthropic.com）
ANTHROPIC_API_KEY=

# Meta 官方 Instagram Graph API（Business Discovery）
# 你自己的 IG 專業帳號 ID（需綁定 Facebook 粉絲專頁）
META_IG_USER_ID=
# 長效 User Access Token，需要權限：instagram_basic、pages_show_list、pages_read_engagement
META_ACCESS_TOKEN=
# 選填，預設 v23.0
META_GRAPH_VERSION=

PORT=3000
